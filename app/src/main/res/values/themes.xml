<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ReservarCamposClub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ReservarCamposClub" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/lime</item>
        <item name="colorOnPrimary">#0E1116</item>
        <item name="colorSecondary">@color/lime</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Botón principal verde lima -->
    <style name="BtnLime" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/lime</item>
        <item name="android:textColor">#0E1116</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Botón secundario (outline) -->
    <style name="BtnOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/lime</item>
        <item name="android:textColor">@color/lime</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Campo de texto oscuro -->
    <style name="InputDark" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/card_dark_2</item>
        <item name="boxBackgroundColor">@color/card_dark_2</item>
        <item name="hintTextColor">@color/text_grey</item>
        <item name="android:textColorHint">@color/text_grey</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="CardDark">
        <item name="cardBackgroundColor">@color/card_dark</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>