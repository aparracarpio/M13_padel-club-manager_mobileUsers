<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_dark"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Franja decorativa lateral -->
        <View
            android:layout_width="6dp"
            android:layout_height="60dp"
            android:background="@color/lime"
            android:layout_marginEnd="14dp"/>

        <!-- Info pista -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombrePista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Pista 1"/>

            <TextView
                android:id="@+id/tvTipoPista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_grey"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:text="Indoor · Cubierta"/>

            <TextView
                android:id="@+id/tvEstadoPista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_ok"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:text="● Disponible"/>
        </LinearLayout>

        <!-- Botón reservar -->
        <Button
            android:id="@+id/btnReservarPista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reservar"
            android:textColor="#0E1116"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_lime_rounded"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>